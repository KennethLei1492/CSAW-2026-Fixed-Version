# =============================================================================
# Keep the repo to documentation, testbenches, and major components.
# Everything below is a tool output / generated intermediate that run_all.sh
# (or the pipeline) regenerates. The small JSON evidence files under build/
# (verification_report, trojan_variants, pin_map, cipher_characterization,
# design_constraints) ARE committed as results; the rest of build/ is ignored.
# =============================================================================

# Toolchain and scaffolds
oss-cad-suite/
*.tgz
csaw26_ai_build/
_pipinstall*.log

# Bitstream reverse-engineering outputs (regenerated by recovery/reverse.sh)
recovery/design.asc
recovery/repacked.bin
recovery/recovered_netlist.v
recovery/recovered_por.v
recovery/cells_sim.v
recovery/oracle_tb_reference.v
recovery/_*.v
recovery/_*.vvp
recovery/ref_*.md
recovery/ref_*.py

# Recovered-cipher intermediates (regenerated by extract_cipher / probe_key / characterize)
recovery/cipher_tables.json
recovery/round_ad.json
recovery/sbox_bram_init.txt

# Hardening / report intermediates (regenerated)
hardening/hardened_params.json
hardening/avalanche*.svg
hardening/waveform.svg
hardening/avalanche_stats.json
hardening/sim_recovered.txt
hardening/sim_trojan.txt
hardening/report.html
hardening/*.vvp

# RAG: the binary vector store and the copyrighted Lattice PDF extractions
# (rebuild the corpus with rag/build_corpus.sh; the vector store with build_vectorstore.py)
rag/chroma_db/
rag/corpus/ice40_design_guidelines.txt
rag/corpus/ice40_spi_i2c_hardened_ip.txt
rag/corpus/_*.html

# Pipeline transient artifacts under build/ (the small result JSONs are committed)
build/sbox_tables.json
build/equiv.log
build/*.ys
build/*.vvp
build/*.out
build/_*

# Simulation / build artifacts
*.vvp
*.vcd
*.out
*.err
*.log

# Python / editor cruft
__pycache__/
*.pyc
.DS_Store

# Redundant packaging
submission.zip
