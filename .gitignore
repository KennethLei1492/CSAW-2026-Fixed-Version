# =============================================================================
# Keep the repo to documentation, testbenches, and major components.
# Everything below is a tool output / generated intermediate that run_all.sh
# regenerates from the committed sources + the bitstream. Do not commit it.
# =============================================================================

# Toolchain and the scaffold produced by rebuild_from_scratch.sh
oss-cad-suite/
*.tgz
csaw26_ai_build/

# Bitstream reverse-engineering outputs (regenerated by recovery/reverse.sh)
recovery/design.asc
recovery/repacked.bin
recovery/recovered_netlist.v
recovery/recovered_por.v
recovery/cells_sim.v
recovery/oracle_tb_reference.v
recovery/_*.v
recovery/_*.vvp

# Recovered-cipher intermediates (regenerated by extract_cipher.py / probe_key.py)
recovery/cipher_tables.json
recovery/round_ad.json
recovery/sbox_bram_init.txt

# Hardening / report intermediates (regenerated by design_hardened / make_figures / build_report)
hardening/hardened_params.json
hardening/avalanche*.svg
hardening/waveform.svg
hardening/avalanche_stats.json
hardening/sim_recovered.txt
hardening/sim_trojan.txt
hardening/report.html
hardening/*.vvp

# Simulation / build artifacts
*.vvp
*.vcd
*.out
*.err
*.log

# Python / editor cruft
__pycache__/
*.pyc
.DS_Store

# Redundant packaging
submission.zip
